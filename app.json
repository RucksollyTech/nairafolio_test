{
  "expo": {
    "name": "nairafolio",
    "slug": "nairafolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "nairafolio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "backgroundColor": "#014148",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      
      "bundleIdentifier": "com.company.myapp",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "nairafolio"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "nairafolio"
            ]
          }
        ],
        "NSFaceIDUsageDescription": "We use Face ID for authentication.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#014148"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.nairafolio.nairafolio",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "nairafolio.com"
            },
            {
              "scheme": "nairafolio"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#014148"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": [
            "./local/assets/notification_sound.wav",
            "./local/assets/notification_sound_other.wav"
          ],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b037add0-cf83-4dc3-b2e6-532c1ee7d90d"
      }
    },
    "owner": "rucksolly"
  }
}
