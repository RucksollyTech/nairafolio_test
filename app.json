{
  "expo": {
    "name": "nairafolio",
    "slug": "nairafolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "nairafolio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "backgroundColor": "#014148",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.company.myapp",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["nairafolio"]
          }
        ]
      }
    },
    "android":  {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#014148"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.nairafolio.nairafolio",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "nairafolio.com"
            },
            {
              "scheme": "nairafolio"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#014148"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
